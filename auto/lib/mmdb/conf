    ngx_feature="MaxMind libmaxminddb library"
    ngx_feature_name=
    ngx_feature_run=no
    ngx_feature_incs="#include <maxminddb.h>"
    ngx_feature_path=
    ngx_feature_libs="-lmaxminddb"
    ngx_feature_test="MMDB_s mmdb;
                      MMDB_open(NULL, MMDB_MODE_MMAP, &mmdb)"
    . auto/feature


if [ $ngx_found = no ]; then

    # FreeBSD port

    ngx_feature="MaxMind libmaxminddb library in /usr/local/"
    ngx_feature_path="/usr/local/include"

    if [ $NGX_RPATH = YES ]; then
        ngx_feature_libs="-R/usr/local/lib -L/usr/local/lib -lmaxminddb"
    else
        ngx_feature_libs="-L/usr/local/lib -lmaxminddb"
    fi

    . auto/feature
fi


if [ $ngx_found = no ]; then

    # NetBSD port

    ngx_feature="MaxMind libmaxminddb library in /usr/pkg/"
    ngx_feature_path="/usr/pkg/include"

    if [ $NGX_RPATH = YES ]; then
        ngx_feature_libs="-R/usr/pkg/lib -L/usr/pkg/lib -lmaxminddb"
    else
        ngx_feature_libs="-L/usr/pkg/lib -lmaxminddb"
    fi

    . auto/feature
fi


if [ $ngx_found = no ]; then

    # MacPorts

    ngx_feature="MaxMind libmaxminddb library in /opt/local/"
    ngx_feature_path="/opt/local/include"

    if [ $NGX_RPATH = YES ]; then
        ngx_feature_libs="-R/opt/local/lib -L/opt/local/lib -lmaxminddb"
    else
        ngx_feature_libs="-L/opt/local/lib -lmaxminddb"
    fi

    . auto/feature
fi


if [ $ngx_found = no ]; then

    # Homebrew on Apple Silicon

    ngx_feature="MaxMind libmaxminddb library in /opt/homebrew/"
    ngx_feature_path="/opt/homebrew/include"

    if [ $NGX_RPATH = YES ]; then
        ngx_feature_libs="-R/opt/homebrew/lib -L/opt/homebrew/lib -lmaxminddb"
    else
        ngx_feature_libs="-L/opt/homebrew/lib -lmaxminddb"
    fi

    . auto/feature
fi


if [ $ngx_found = yes ]; then

    CORE_INCS="$CORE_INCS $ngx_feature_path"

    if [ $USE_MMDB = YES ]; then
        CORE_LIBS="$CORE_LIBS $ngx_feature_libs"
    fi

    NGX_LIB_MMDB=$ngx_feature_libs

else

cat << END

$0: error: the GeoIP2 module requires the MaxMind libmaxminddb library.
Install libmaxminddb-dev (Debian/Ubuntu) or libmaxminddb-devel (RHEL) and retry.

END

    exit 1
fi
