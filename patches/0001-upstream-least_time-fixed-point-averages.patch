diff --git a/src/http/ngx_http_upstream_round_robin.h b/src/http/ngx_http_upstream_round_robin.h
index ec39cb6e6..cda666cd2 100644
--- a/src/http/ngx_http_upstream_round_robin.h
+++ b/src/http/ngx_http_upstream_round_robin.h
@@ -247,10 +247,32 @@ typedef struct {
 } ngx_http_upstream_rr_peer_data_t;
 
 
+/*
+ * averages are kept in 1/NGX_HTTP_UPSTREAM_AVG_SCALE ms units: with whole
+ * milliseconds, rounding discards any sample within 10 ms of the average,
+ * so the average cannot track response times that change by less than that
+ */
+#define NGX_HTTP_UPSTREAM_AVG_SCALE  64
+
+#define ngx_http_upstream_avg_msec(avg)                                        \
+    (((avg) + NGX_HTTP_UPSTREAM_AVG_SCALE / 2) / NGX_HTTP_UPSTREAM_AVG_SCALE)
+
+
 /* exponential moving average + rounding */
-#define ngx_http_upstream_response_time_avg(avg, v)                            \
-    *(avg) = (*(avg) ? (0.5 + ((double) (v) * 0.05 + (double) (*(avg)) * 0.95))\
-                     : (v))
+static ngx_inline void
+ngx_http_upstream_response_time_avg(ngx_msec_t *avg, ngx_msec_t v)
+{
+    double  a;
+
+    a = (double) v * NGX_HTTP_UPSTREAM_AVG_SCALE;
+
+    if (*avg) {
+        a = 0.5 + a * 0.05 + (double) *avg * 0.95;
+    }
+
+    *avg = (a < (double) NGX_MAX_INT32_VALUE) ? (ngx_msec_t) a
+                                              : NGX_MAX_INT32_VALUE;
+}
 
 
 ngx_int_t ngx_http_upstream_init_round_robin(ngx_conf_t *cf,
