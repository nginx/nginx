     server {
         listen      127.0.0.1:8085;
         proxy_pass  u;
@@ -153,6 +165,16 @@ stream {
         listen      127.0.0.1:8096;
         proxy_pass  u11;
     }
+
+    server {
+        listen      127.0.0.1:8097;
+        proxy_pass  u12;
+    }
+
+    server {
+        listen      127.0.0.1:8098;
+        proxy_pass  u13;
+    }
 }
 
 http {
@@ -193,7 +215,7 @@ $t->write_file('index.html', '0123456789' x 204);
 
 $t->run_daemon(\&http_daemon, port(8083));
 $t->run_daemon(\&http_daemon, port(8084));
-$t->try_run('no least_time')->plan(13);
+$t->try_run('no least_time')->plan(15);
 
 $t->waitforsocket('127.0.0.1:' . port(8083));
 $t->waitforsocket('127.0.0.1:' . port(8084));
@@ -265,6 +287,31 @@ http_end $_ for @s;
 is(many('/', 10, "127.0.0.1:$p9"), "$p1: 10", 'greater last byte time');
 
 
+# last byte times within the same bucket are considered equal,
+# so the slower peer is still selected
+
+my $p17 = port(8097);
+
+@s = map {
+	http_get('/?r=1', start => 1, socket => getconn("127.0.0.1:$p17"))
+} (1 .. 6);
+http_end $_ for @s;
+
+like(many('/', 10, "127.0.0.1:$p17"), qr/$p1: [1-9], $p2: [1-9]/, 'bucket');
+
+
+# smoothed last byte time, faster peer wins
+
+my $p18 = port(8098);
+
+@s = map {
+	http_get('/?r=1', start => 1, socket => getconn("127.0.0.1:$p18"))
+} (1 .. 6);
+http_end $_ for @s;
+
+is(many('/', 10, "127.0.0.1:$p18"), "$p2: 10", 'smooth');
+
+
