+
+    if (ltp->conf->smooth == 0) {
+        return NGX_HTTP_UPSTREAM_AVG_WEIGHT;
+    }
+
+    /*
+     * a sample has the weight of at least the fraction of the smoothing
+     * time elapsed since the previous sample, so averages of peers with
